# ==============================================================================
# SNAPCUT AI - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT SECURITY RULES:
# 1. NEVER commit real secret keys, private credentials, or .env files to GitHub.
# 2. Only keys prefixed with VITE_ are exposed to the browser client bundle.
# 3. Private keys (Supabase Service Role, AI Provider Secrets, bKash Secrets)
#    must ONLY be configured inside n8n Cloud credentials or backend functions.
# ==============================================================================

# --- CLIENT-SIDE ENVIRONMENT VARIABLES (Vite Frontend) ---
# Supabase Public API (Phase 4 & 5)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# n8n Webhook Base URL (Phase 7 & 11)
VITE_N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook

# Cloudinary Public Configuration (Phase 6)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=snapcut_ephemeral_unsigned

# App Base URL
VITE_APP_URL=http://localhost:5173

# --- BACKEND / SECURE SERVICES (For n8n Cloud & Supabase Functions Only) ---
# DO NOT PREFIX WITH VITE_ - DO NOT USE IN CLIENT JAVASCRIPT
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# AI_REMOVAL_API_KEY=your-ai-provider-api-key
# CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# BKASH_APP_KEY=your-bkash-app-key
# BKASH_APP_SECRET=your-bkash-app-secret
# BKASH_USERNAME=your-bkash-merchant-username
# BKASH_PASSWORD=your-bkash-merchant-password
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v2.0
